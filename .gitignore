# Build directories
build/
target/
android/.build/
*.o
*.so
*.dylib

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test results (may contain sensitive data)
test-results/*
!test-results/.gitignore

# Upstream cloned repos
upstream/

# Temporary files
*.tmp
*.log
*.bak

# Pairing keys and personal data (never commit)
*.key
*.db

# Raw Bluetooth and network captures (private unless explicitly sanitized)
*.btsnoop
*.cfa
*.pcap
*.pcapng

# Local configuration and authentication material
.env
*.token
*.sqlite
*.sqlite3
